{
  "name": "performance-dev-tools",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  },
  "scripts": {
    "format": "biome format --write benchmarks/http package.json biome.json",
    "format-check": "biome check --formatter-enabled=true --linter-enabled=false --assist-enabled=false benchmarks/http package.json biome.json",
    "lint": "biome lint --error-on-warnings benchmarks/http package.json biome.json"
  }
}
